        "# %%\n",
        "#課題008\n",
        "#ライブラリの読み込み\n",
        "import random\n",
        "\n",
        "# 1から100までのランダムな正の整数（自然数）を生成してvarに代入\n",
        "var = random.randint(1, 100)\n",
        "print(var)\n",
        "\n",
        "# 条件分岐\n",
        "if var % 3 == 0 and var % 5 == 0:\n",
        "    print(\"FizzBuzz\")\n",
        "elif var % 3 == 0:\n",
        "    print(\"Fizz\")\n",
        "elif var % 5 == 0:\n",
        "    print(\"Buzz\")\n",
        "else:\n",
        "    print(var)"
      ]
    }
  ]
}