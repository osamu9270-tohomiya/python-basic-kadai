        "#課題013\n",
        "def add_two_arguments(price, tax_rate):\n",
        "    # 与えられた引数priceと引数comsumption_taxを加算し、変数totalに代入する\n",
        "    tax = price * tax_rate/100\n",
        "    return price + tax\n",
        "\n",
        "# 関数を呼び出し、引数として購入金額と消費税を渡す\n",
        "total = add_two_arguments(110, 10)\n",
        "# 変数$totalの値を出力する\n",
        "print(f\"{total}円\")"
      ]
